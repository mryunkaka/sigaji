# Environment variables
.env
.env.local
.env.production
.env.*.local

# Storage and logs
/storage/*
!/storage/.gitignore
/storage/logs/*
/storage/cache/*
/storage/sessions/*
/storage/uploads/*

# Database
*.sql
*.sqlite
*.sqlite3
*.db

# Backup files
*.bak
*.backup
*.old
*.tmp
*.swp
*~

# OS files
.DS_Store
Thumbs.db
desktop.ini

# IDE files
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Node modules
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build artifacts
dist/
build/
*.min.js.map
*.min.css.map

# Security sensitive files
config/security.php
config/keys.php
*.pem
*.key
*.crt
*.cert

# Server config (local only)
nginx.conf.local
apache.conf.local
php.ini.local

# Temporary files
tmp/
temp/
*.tmp
